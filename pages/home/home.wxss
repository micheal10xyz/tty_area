.home {
  padding-bottom: 140rpx;
}

.nav-op {
  font-size: 28rpx;
  color: var(--primary);
  padding: 0 8rpx;
  line-height: 1;
}

/* 骨架 */
.home-loading {
  padding: 24rpx;
}
.skeleton {
  height: 160rpx;
  border-radius: 24rpx;
  background: #EEF0F3;
  margin-bottom: 20rpx;
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 位置条 */
.loc-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}
.loc-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 10rpx;
}
.loc-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}
.mode-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--text3);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 0 10rpx;
}

/* 搜索 */
.search-box {
  margin: 20rpx 24rpx 24rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #F2F3F5;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--text3);
  border-radius: 50%;
  position: relative;
  margin-right: 18rpx;
  flex: none;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  background: var(--text3);
  transform: rotate(45deg);
  left: 18rpx;
  top: 18rpx;
  border-radius: 2rpx;
}
.search-ph {
  font-size: 28rpx;
  color: var(--text3);
}

/* 常用热线 */
.hotline-card {
  margin: 0 24rpx 20rpx;
  background: var(--blue-bg);
  border-radius: 24rpx;
  padding: 24rpx 20rpx 16rpx;
}
.hotline-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 16rpx;
}
.hotline-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--blue);
}
.hot-grid {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.hot-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.hot-avatar.blue { background: var(--blue); }
.hot-name {
  font-size: 22rpx;
  color: var(--text2);
  text-align: center;
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 分区 */
.sec {
  margin: 0 24rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  padding: 12rpx 4rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 600;
}
.sec-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text3);
}

/* 分类宫格 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 8rpx;
}
.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.cat-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--brand-bg);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.cat-name {
  font-size: 22rpx;
  color: var(--text2);
}

.li-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.press { opacity: 0.8; }

.state-box.mini { padding: 60rpx 40rpx; }

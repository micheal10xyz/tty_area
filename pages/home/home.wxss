.home {
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
}

/* 骨架 */
.home-loading {
  padding: 24rpx;
}
.skeleton {
  height: 160rpx;
  border-radius: 24rpx;
  background: #E4ECF7;
  margin-bottom: 20rpx;
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ===== 顶部区域：小区定位（轻） + 搜索框（重） ===== */
.top-area {
  padding: 4rpx 24rpx 20rpx;
}
/* 小区：退化为纯文字点击区，不与搜索框抢视觉 */
.loc-picker {
  position: relative;
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 52rpx;
  padding: 0 4rpx;
}
/* 上下各扩 18rpx，保证点击热区约 88rpx */
.loc-picker::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -18rpx;
  bottom: -18rpx;
}
.loc-picker-press {
  opacity: 0.55;
}
/* 定位针 */
.loc-pin {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  margin: 0 12rpx 2rpx 0;
  border: 4rpx solid var(--primary);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.loc-text {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.loc-arrow {
  flex: none;
  margin-left: 6rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--text3);
}

/* 搜索框：整行拉满 + 白底浮起 + 主色描边，作为首屏视觉重点 */
.search-box {
  margin-top: 12rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(58, 104, 150, 0.16);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.search-press {
  transform: scale(0.985);
  opacity: 0.92;
}
.search-icon {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--primary);
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex: none;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 4rpx;
  background: var(--primary);
  transform: rotate(45deg);
  left: 19rpx;
  top: 19rpx;
  border-radius: 2rpx;
}
.search-ph {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 分区卡片：统一白底 + 轻阴影，替代大面积蓝块 ===== */
.panel {
  margin: 0 24rpx 20rpx;
  padding: 4rpx 24rpx 12rpx;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(54, 72, 92, 0.04);
}
.panel-head {
  display: flex;
  align-items: center;
  padding: 22rpx 0 8rpx;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.panel-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text3);
}

/* 常用热线：2 列 × 3 行，只保留名称，不再展示服务时间等细节 */
.hot-grid {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
}
.hot-avatar {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #F1F6FC;
  border: 1rpx solid #E2EBF7;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.hot-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 小区动态：最新公告列表 */
.dyn-list {
  padding-bottom: 4rpx;
}
.dyn-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #EDF2F9;
}
.dyn-item:first-child {
  border-top: none;
}
.dyn-tag {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #F1F6FC;
  border: 1rpx solid #E2EBF7;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}
.dyn-main {
  flex: 1;
  min-width: 0;
}
.dyn-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dyn-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dyn-date {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text3);
}
.dyn-empty {
  padding: 28rpx 0 32rpx;
  font-size: 24rpx;
  color: var(--text3);
  text-align: center;
}

/* 服务承诺（轻量提示，填补首屏下半部空白） */
.commit-card {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #F4F7FB;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}
.commit-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(54, 114, 158, .14);
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 700;
  font-style: italic;
  font-family: Georgia, 'Times New Roman', serif;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}
.commit-main {
  flex: 1;
  min-width: 0;
}
.commit-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}
.commit-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text3);
  line-height: 1.4;
}

.press { opacity: 0.8; }

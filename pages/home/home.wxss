.home {
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
}

/* 骨架 */
.home-loading {
  padding: 24rpx;
}
.skeleton {
  height: 160rpx;
  border-radius: 24rpx;
  background: #E4ECF7;
  margin-bottom: 20rpx;
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 位置条 */
.loc-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}
.loc-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 10rpx;
}
.loc-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

/* 搜索 */
.search-box {
  margin: 20rpx 24rpx 24rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #E6EDF8;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--text3);
  border-radius: 50%;
  position: relative;
  margin-right: 18rpx;
  flex: none;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  background: var(--text3);
  transform: rotate(45deg);
  left: 18rpx;
  top: 18rpx;
  border-radius: 2rpx;
}
.search-ph {
  font-size: 28rpx;
  color: var(--text3);
}

/* 常用热线 */
.hotline-card {
  margin: 0 24rpx 20rpx;
  background: var(--blue-bg);
  border-radius: 24rpx;
  padding: 24rpx 20rpx 16rpx;
}
.hotline-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 16rpx;
}
.hotline-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--blue);
}
.sec-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--blue);
  opacity: 0.75;
}
.hot-grid {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.hot-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.hot-name {
  font-size: 22rpx;
  color: var(--text2);
  text-align: center;
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 公告速递 */
.notice-card {
  margin: 0 24rpx;
  display: flex;
  align-items: center;
}
.notice-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.notice-icon {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #E4ECF7;
  color: var(--orange);
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.notice-main {
  flex: 1;
  min-width: 0;
}
.notice-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.notice-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.notice-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 40rpx;
  color: #8FA6BF;
}

.press { opacity: 0.8; }

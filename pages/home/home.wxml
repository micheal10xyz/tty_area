<navigation-bar background="#EFF4FB" color="#36485C" back="{{false}}"></navigation-bar>

<view class="page home">

  <block wx:if="{{loading}}">
    <view class="home-loading">
      <view class="skeleton"></view>
      <view class="skeleton"></view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="state-box">
      <view class="state-icon">!</view>
      <view class="state-title">加载失败</view>
      <view class="state-desc">请检查网络后重试</view>
      <button class="btn btn-primary btn-sm" hover-class="btn-press" bindtap="retry">重新加载</button>
    </view>
  </block>

  <block wx:else>
    <!-- 顶部：当前小区 + 搜索（搜索框为首屏视觉重点） -->
    <view class="top-area">
      <view class="loc-picker" hover-class="loc-picker-press" bindtap="goZonePicker">
        <view class="loc-pin"></view>
        <text class="loc-text">{{zone}}</text>
        <text class="loc-arrow">›</text>
      </view>

      <view class="search-box" hover-class="search-press" bindtap="goSearch">
        <view class="search-icon"></view>
        <text class="search-ph">搜服务，如：开锁、疏通</text>
      </view>
    </view>

    <!-- 常用热线：首页只放 6 个最常用入口，其余走「查看全部」 -->
    <view class="panel">
      <view class="panel-head">
        <view class="panel-title">常用热线</view>
        <text class="panel-more" bindtap="goAllHotline">查看全部 ›</text>
      </view>
      <view class="hot-grid">
        <view wx:for="{{hotlines}}" wx:key="_id" class="hot-item" hover-class="press"
              data-id="{{item._id}}" data-name="{{item.name}}" data-phone="{{item.phone}}" bindtap="dialHotline">
          <view class="hot-avatar">{{item.glyph}}</view>
          <text class="hot-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 小区动态：展示最新公告，点条目或「全部公告」进入公告 Tab -->
    <view class="panel">
      <view class="panel-head">
        <view class="panel-title">小区动态</view>
        <text class="panel-more" bindtap="goNotice">全部公告 ›</text>
      </view>
      <view wx:if="{{notices.length}}" class="dyn-list">
        <view wx:for="{{notices}}" wx:key="_id" class="dyn-item" hover-class="press" bindtap="goNotice">
          <view class="dyn-tag">{{item.glyph}}</view>
          <view class="dyn-main">
            <view class="dyn-name">{{item.title}}</view>
            <view class="dyn-sub">{{item.summary}}</view>
          </view>
          <text class="dyn-date">{{item.dateText}}</text>
        </view>
      </view>
      <view wx:else class="dyn-empty">暂无最新公告</view>
    </view>

    <!-- 服务承诺（轻量提示，填补首屏下半部空白） -->
    <view class="commit-card">
      <view class="commit-icon">i</view>
      <view class="commit-main">
        <view class="commit-title">号码可能变化，拨打前请先核实</view>
        <view class="commit-desc">如有错误，欢迎在「我的 · 意见反馈」中告诉我们</view>
      </view>
    </view>
  </block>
</view>

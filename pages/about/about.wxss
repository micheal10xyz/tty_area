.page {
  padding: 24rpx;
}

.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}
.hero-logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 34rpx;
  background: var(--primary);
  color: #fff;
  font-size: 64rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 20rpx;
}
.hero-ver {
  font-size: 24rpx;
  color: var(--text3);
  margin-top: 8rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.block-text {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.txt-line {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0;
}
.actions .btn {
  flex: 1;
}

.detail {
  padding: 20rpx 24rpx 0;
}

.hero {
  margin-bottom: 20rpx;
}
.hero-top {
  display: flex;
  align-items: center;
}
.glyph.big {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  font-size: 44rpx;
  margin-right: 24rpx;
}
.hero-main {
  flex: 1;
  min-width: 0;
}
.big-name {
  font-size: 36rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hero-tags {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  color: var(--primary);
  background: var(--brand-bg);
}
.tag.blue {
  color: var(--blue);
  background: var(--blue-bg);
}
.tag.orange {
  color: var(--orange);
  background: #E4ECF7;
}
.tag.gray {
  color: var(--text3);
  background: #E4ECF7;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text3);
}

/* 电话行 */
.phone-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: var(--brand-bg);
  border-radius: 20rpx;
  padding: 20rpx;
}
.phone-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.phone-main {
  flex: 1;
  min-width: 0;
}
.phone-num {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}
.phone-tip {
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 4rpx;
}
.dial-call {
  flex: none;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}
.hero-count {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text3);
  text-align: right;
}

/* 信息 */
.info-row {
  display: flex;
  padding: 10rpx 0;
}
.info-label {
  flex: none;
  width: 150rpx;
  color: var(--text3);
  font-size: 26rpx;
}
.info-val {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

.block-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.block-text {
  font-size: 27rpx;
  color: var(--text2);
  line-height: 1.7;
}

.note-line {
  font-size: 24rpx;
  color: var(--text3);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.bottom-space {
  height: 160rpx;
}

.flex-1 {
  flex: 1;
}
.flex-2 {
  flex: 2;
}
.press {
  opacity: 0.85;
}

.zone-page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.zone-tip {
  padding: 0 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--text3);
  line-height: 1.6;
}

.zone-list {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
}

.zone-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 28rpx;
}
/* 分隔线 */
.zone-row::after {
  content: '';
  position: absolute;
  left: 68rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line);
}
.zone-row.last::after {
  display: none;
}
.zone-row.press {
  background: #F2F6FC;
}

/* 定位针 */
.zone-pin {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin: 0 20rpx 2rpx 2rpx;
  border: 4rpx solid var(--text3);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.zone-name {
  font-size: 30rpx;
  color: var(--text);
}

.zone-row.active .zone-pin {
  border-color: var(--primary);
}
.zone-row.active .zone-name {
  color: var(--primary);
  font-weight: 600;
}

.zone-badge {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--primary);
}

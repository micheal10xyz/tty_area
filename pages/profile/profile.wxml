<navigation-bar background="#FFFFFF" color="#1F2329" title="我的" back="{{true}}">
</navigation-bar>

<view class="page">
  <view class="head-card">
    <view class="head-avatar">民</view>
    <view class="head-info">
      <view class="head-name">天通苑西二区邻居</view>
      <view class="head-sub">公益整理 · 自助查询无需登录</view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" hover-class="press" bindtap="goMine">
      <view class="menu-icon">记</view>
      <text class="menu-text">我的提交</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="press" bindtap="goFeedback">
      <view class="menu-icon blue">馈</view>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="press" bindtap="goAbout">
      <view class="menu-icon gray">关</view>
      <text class="menu-text">关于与公益声明</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card note">
    <view class="note-line">平台不介入交易、不收取任何费用。</view>
    <view class="note-line">收录内容均经人工核实，信息如有出入请使用「纠错」反馈。</view>
  </view>

  <view class="meta">
    <text>天通苑便民 v{{version}}</text>
  </view>

  <view class="home-link" bindtap="goHome">返回首页</view>
</view>

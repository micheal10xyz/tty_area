<navigation-bar background="#FFFFFF" color="#36485C" title="我的" back="{{false}}">
</navigation-bar>

<view class="page">
  <view class="head-card">
    <view class="head-avatar">民</view>
    <view class="head-info">
      <view class="head-name">天通苑西二区邻居</view>
      <view class="head-sub">公益整理 · 自助查询无需登录</view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" hover-class="press" bindtap="goFeedback">
      <view class="menu-icon blue">馈</view>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="press" bindtap="goAbout">
      <view class="menu-icon gray">关</view>
      <text class="menu-text">关于与公益声明</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card note">
    <view class="note-line">平台为公益整理，不介入交易、不收取任何费用。</view>
    <view class="note-line">服务信息可能发生变化，请拨打前自行核实；内容如有出入，可通过「意见反馈」告知我们。</view>
  </view>

  <view class="meta">
    <text>天通苑便民 v{{version}}</text>
  </view>
</view>

.page {
  padding: 24rpx;
}

.head-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #00A870, #12C98C);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
}
.head-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.head-info {
  flex: 1;
}
.head-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
.head-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.menu {
  padding: 8rpx 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand-bg);
  color: var(--primary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.menu-icon.blue {
  background: var(--blue-bg);
  color: var(--blue);
}
.menu-icon.gray {
  background: #EFF1F3;
  color: var(--text2);
}
.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}
.menu-arrow {
  font-size: 40rpx;
  color: #C9CDD2;
}

.note {
  background: #FFF8E8;
}
.note-line {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.8;
}

.meta {
  text-align: center;
  font-size: 22rpx;
  color: var(--text3);
  margin-top: 30rpx;
}
.home-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 20rpx;
  padding: 20rpx;
}
.press {
  opacity: 0.8;
}

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-top: 1rpx solid #D7E2F1;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 12rpx;
  --ic: #8BA4BF;
}
.tab-item.on {
  --ic: #35689C;
}

/* 选中指示条 */
.tab-ind {
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 4rpx;
  margin-left: -20rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: var(--ic);
  opacity: 0;
  transition: opacity 0.2s;
}
.tab-item.on .tab-ind {
  opacity: 1;
}

/* 图标画布 */
.tab-ic {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.2s ease;
}
.tab-item.on .tab-ic {
  transform: scale(1.08);
}
.tab-ic view {
  position: absolute;
  box-sizing: border-box;
}

/* 首页：屋顶 + 房身（统一线性） */
.i-home {
  width: 46rpx;
  height: 46rpx;
}
.h-roof {
  left: 12rpx;
  top: 9rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid var(--ic);
  border-top: 4rpx solid var(--ic);
  border-radius: 4rpx 0 0 0;
  transform: rotate(45deg);
}
.h-body {
  left: 10rpx;
  top: 21rpx;
  width: 26rpx;
  height: 22rpx;
  border: 4rpx solid var(--ic);
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

/* 公告：铃铛 */
.i-notice {
  width: 46rpx;
  height: 46rpx;
}
.n-knob {
  left: 20rpx;
  top: 0;
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--ic);
}
.n-dome {
  left: 10rpx;
  top: 5rpx;
  width: 26rpx;
  height: 27rpx;
  border: 4rpx solid var(--ic);
  border-bottom: none;
  border-radius: 15rpx 15rpx 4rpx 4rpx;
}
.n-base {
  left: 8rpx;
  top: 30rpx;
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--ic);
}
.n-clap {
  left: 19rpx;
  top: 36rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--ic);
}

/* 服务：宫格（线性统一） */
.i-services {
  width: 46rpx;
  height: 46rpx;
}
.s-dot {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--ic);
  border-radius: 5rpx;
}
.s-dot.s1 { left: 3rpx; top: 3rpx; }
.s-dot.s2 { left: 25rpx; top: 3rpx; }
.s-dot.s3 { left: 3rpx; top: 25rpx; }
.s-dot.s4 { left: 25rpx; top: 25rpx; }

/* 我的：人形 */
.i-mine {
  width: 46rpx;
  height: 46rpx;
}
.m-head {
  left: 13rpx;
  top: 1rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid var(--ic);
  border-radius: 50%;
}
.m-shoulder {
  left: 7rpx;
  top: 24rpx;
  width: 32rpx;
  height: 19rpx;
  border: 4rpx solid var(--ic);
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}

/* 文字 */
.tab-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ic);
  line-height: 1.2;
  transition: color 0.2s;
}
.tab-item.on .tab-text {
  font-weight: 600;
}
